/* ===========================================================================
   Automation Project Client - Dark Industrial theme  (v2)
   I segnaposto tra chiocciole (es. ACCENT) sono sostituiti da client/theme/tokens.py
   Griglia 4/8 px. Scala tipografica:
     11px eyebrow (maiuscoletto)  ·  12px didascalie/header tabella  ·  13px testo  ·  16px h2  ·  24px h1
   Raggi: controlli 8px, pannelli 10px, schede 12px.
   Solo proprieta' supportate da Qt Style Sheets (niente proprieta' CSS web non supportate).
   =========================================================================== */
* {
    font-family: @FONT_UI@;
    font-size: 13px;
    color: @TEXT@;
    outline: 0;
}
QWidget { background-color: @BG_0@; }
QMainWindow, QDialog, QStackedWidget { background-color: @BG_0@; }
QLabel { background: transparent; }

/* ---- tipografia ------------------------------------------------------------ */
QLabel[muted="true"] { color: @MUTED@; }
QLabel[h1="true"] { font-size: 24px; font-weight: 700; color: @TEXT@; }
QLabel[h2="true"] { font-size: 16px; font-weight: 600; }
QLabel[h3="true"] { font-size: 14px; font-weight: 600; }
QLabel[subtitle="true"] { font-size: 13px; color: @MUTED@; }
QLabel[eyebrow="true"] { font-size: 11px; font-weight: 700; color: @MUTED@; }
QLabel[caption="true"] { font-size: 12px; color: @MUTED@; }
QLabel[mono="true"] { font-family: @FONT_MONO@; }
QLabel[error="true"] { color: @RED@; }
QToolTip {
    background-color: @BG_1@; color: @TEXT@; border: 1px solid @BORDER_STRONG@; border-radius: 6px;
    padding: 6px 10px; font-size: 12px;
}

/* ---- sidebar --------------------------------------------------------------- */
QFrame#Sidebar {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @SIDEBAR_TOP@, stop:1 @SIDEBAR_BOTTOM@);
    border-right: 1px solid @BORDER@;
}
QFrame#Sidebar QLabel { background: transparent; }
/* le voci (NavButton) si dipingono da sole: sfondo, barra attiva e hover sono disegnati in paintEvent */
QFrame#Sidebar QToolButton { background: transparent; border: none; border-radius: 0; padding: 0; }
QFrame#Sidebar QToolButton#IconBtn { border: 1px solid transparent; border-radius: 8px; padding: 5px; }
QFrame#Sidebar QToolButton#IconBtn:hover { background-color: @SURFACE_2@; border-color: @BORDER@; }
QFrame#Sidebar QToolButton#IconBtn:pressed { background-color: @BG_1@; }
QLabel#Brand { font-size: 15px; font-weight: 800; }
QLabel#BrandSub { color: @MUTED@; font-size: 11px; }
QFrame#SideDivider { background-color: @BORDER_SOFT@; border: none; max-height: 1px; min-height: 1px; }
QFrame#UserChip {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @SURFACE_TOP@, stop:1 @SURFACE_BOTTOM@);
    border: 1px solid @BORDER@; border-radius: 12px;
}
QFrame#UserChip QLabel { background: transparent; }
QFrame#ConnChip { background-color: rgba(255, 255, 255, 6); border: 1px solid @BORDER_SOFT@; border-radius: 10px; }
QFrame#ConnChip QLabel { background: transparent; }

/* ---- schede / pannelli ----------------------------------------------------- */
QFrame#Card, QFrame[card="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @SURFACE_TOP@, stop:1 @SURFACE_BOTTOM@);
    border: 1px solid @BORDER@; border-radius: 12px;
}
QFrame#Card[clickable="true"]:hover { border: 1px solid @ACCENT_ALT@; }
QFrame#Card QLabel, QFrame[card="true"] QLabel { background: transparent; }
QFrame#Panel { background-color: @SURFACE_1@; border: 1px solid @BORDER@; border-radius: 10px; }
QFrame#Panel QLabel { background: transparent; }
QFrame#Toolbar { background-color: @BG_1@; border-bottom: 1px solid @BORDER@; }
QFrame#InfoBar { background-color: @BG_1@; border: 1px solid @BORDER_SOFT@; border-radius: 10px; }
QFrame#InfoBar QLabel { background: transparent; }
QFrame#Chip {
    background-color: @SURFACE_2@; border: 1px solid @BORDER@; border-radius: 10px;
}
QFrame#Chip QLabel { background: transparent; color: @MUTED@; font-size: 11px; font-family: @FONT_MONO@; }
QFrame#Hero { background-color: @BG_1@; border-right: 1px solid @BORDER@; }
QFrame#FeatureTile { background-color: rgba(0, 229, 255, 22); border: 1px solid rgba(0, 229, 255, 56); border-radius: 10px; }
QFrame#EmptyState { background: transparent; border: 1px dashed @BORDER_STRONG@; border-radius: 12px; }
QFrame#EmptyState QLabel { background: transparent; }
QFrame#EmptyPlain { background: transparent; border: none; }
QFrame#EmptyPlain QLabel { background: transparent; }
QFrame#Callout { background-color: @BG_1@; border: 1px solid @BORDER@; border-left: 3px solid @ACCENT@; border-radius: 8px; }
QGroupBox {
    background-color: @SURFACE_1@; border: 1px solid @BORDER@; border-radius: 10px;
    margin-top: 14px; padding: 16px 12px 12px 12px; font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: @MUTED@; background: transparent; }

/* ---- pulsanti ---------------------------------------------------------------- */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #323847, stop:1 #2A2F3B);
    border: 1px solid @BORDER_STRONG@; border-radius: 8px;
    padding: 7px 16px; font-weight: 500; min-height: 18px;
}
QPushButton:hover { background-color: @SURFACE_3@; border-color: @ACCENT_ALT@; }
QPushButton:pressed { background-color: @BG_1@; border-color: @ACCENT_ALT@; }
QPushButton:disabled { color: @DISABLED@; background-color: @SURFACE_1@; border-color: @BORDER@; }
QPushButton:focus { border-color: @ACCENT@; }
QPushButton[variant="primary"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1CEAFF, stop:1 #00D2E8);
    color: @TEXT_ON_ACCENT@; border: 1px solid #00B9CE; font-weight: 700;
}
QPushButton[variant="primary"]:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7AF3FF, stop:1 #3FE8FB); border-color: @ACCENT_HOVER@; }
QPushButton[variant="primary"]:pressed { background-color: @ACCENT_PRESS@; border-color: @ACCENT_PRESS@; }
QPushButton[variant="primary"]:disabled { background-color: #1F4E57; color: #6C8C93; border-color: #1F4E57; }
QPushButton[variant="success"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2DF28A, stop:1 #00D96E);
    color: #04180D; border: 1px solid #00BD5F; font-weight: 700;
}
QPushButton[variant="success"]:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7BFFB8, stop:1 #4DFFA4); border-color: #4DFFA4; }
QPushButton[variant="success"]:pressed { background-color: #00B85F; border-color: #00B85F; }
QPushButton[variant="success"]:disabled { background-color: #1D4A33; color: #5F8C74; border-color: #1D4A33; }
QPushButton[variant="danger"] { background-color: rgba(255, 82, 82, 10); color: @RED@; border: 1px solid #A8404A; font-weight: 600; }
QPushButton[variant="danger"]:hover { background-color: @DEL_BG@; border-color: @RED@; }
QPushButton[variant="danger"]:pressed { background-color: #3A1B20; }
QPushButton[variant="danger"]:disabled { color: #6B4044; border-color: #4A2F32; background-color: transparent; }
QPushButton[variant="warning"] { background-color: rgba(255, 171, 64, 10); color: @ORANGE@; border: 1px solid #9C6B1C; font-weight: 600; }
QPushButton[variant="warning"]:hover { background-color: @CHG_BG@; border-color: @ORANGE@; }
QPushButton[variant="warning"]:pressed { background-color: #382C12; }
QPushButton[variant="warning"]:disabled { color: #6E5B3C; border-color: #4B4030; background-color: transparent; }
QPushButton[variant="ghost"] { background-color: transparent; border: 1px solid transparent; color: @MUTED@; }
QPushButton[variant="ghost"]:hover { color: @TEXT@; background-color: @SURFACE_2@; border-color: @BORDER@; }
QPushButton[variant="ghost"]:pressed { background-color: @BG_1@; }
QPushButton[seg="true"] { border-radius: 0; padding: 6px 16px; background-color: @SURFACE_1@; border-color: @BORDER_STRONG@; color: @MUTED@; }
QPushButton[seg="true"][segpos="left"] { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QPushButton[seg="true"][segpos="right"] { border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-left: none; }
QPushButton[seg="true"]:hover { color: @TEXT@; background-color: @SURFACE_2@; }
QPushButton[seg="true"]:checked { background-color: @ACCENT_DIM@; border-color: @ACCENT@; color: @ACCENT@; font-weight: 700; }
QToolButton { background: transparent; border: 1px solid transparent; border-radius: 8px; padding: 5px; }
QToolButton:hover { background-color: @SURFACE_2@; border-color: @BORDER@; }
QToolButton:pressed { background-color: @BG_1@; }

/* ---- input ------------------------------------------------------------------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QComboBox {
    background-color: @FIELD_BG@; border: 1px solid @BORDER_STRONG@; border-radius: 8px; padding: 7px 10px;
    selection-background-color: @ACCENT_ALT@; selection-color: white; min-height: 18px;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #5E6780; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border: 1px solid @ACCENT@; background-color: #14181D;
}
QComboBox:on { border: 1px solid @ACCENT@; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: @DISABLED@; background-color: @SURFACE_1@; border-color: @BORDER@; }
QLineEdit[invalid="true"] { border: 1px solid @RED@; }
QComboBox::drop-down { border: none; width: 26px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url("@ASSETS@/chevron-down.svg"); width: 12px; height: 12px; margin-right: 8px; }
QAbstractItemView QComboBox, QAbstractItemView QLineEdit { padding: 3px 10px; min-height: 16px; border-radius: 7px; }
QComboBox QAbstractItemView {
    background-color: @SURFACE_2@; border: 1px solid @BORDER_STRONG@; border-radius: 8px;
    selection-background-color: @ACCENT_DIM@; selection-color: @ACCENT@; padding: 4px; outline: 0;
}
QSpinBox, QDoubleSpinBox { padding-right: 24px; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border; subcontrol-position: top right; width: 22px; border: none; border-top-right-radius: 7px;
    background: transparent; margin-top: 1px; margin-right: 1px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border; subcontrol-position: bottom right; width: 22px; border: none; border-bottom-right-radius: 7px;
    background: transparent; margin-bottom: 1px; margin-right: 1px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover, QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover { background-color: @SURFACE_2@; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url("@ASSETS@/chevron-up.svg"); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url("@ASSETS@/chevron-down.svg"); width: 10px; height: 10px; }
QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: @FIELD_BG@; border: 1px solid @BORDER@; border-radius: 10px; padding: 8px;
    selection-background-color: @ACCENT_ALT@; selection-color: white;
}
QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid @ACCENT@; }
QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid @BORDER_STRONG@; background: @FIELD_BG@; }
QCheckBox::indicator { border-radius: 5px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: @ACCENT@; }
QCheckBox::indicator:checked { background-color: @ACCENT@; border-color: @ACCENT@; image: url("@ASSETS@/check.svg"); }
QCheckBox::indicator:checked:disabled { background-color: #1F4E57; border-color: #1F4E57; }
QWidget#cell { background: transparent; }
QRadioButton::indicator:checked { background-color: @ACCENT@; border: 4px solid @FIELD_BG@; outline: 1px solid @ACCENT@; }
QCheckBox:disabled, QRadioButton:disabled { color: @DISABLED@; }

/* ---- tabelle / liste / alberi --------------------------------------------------- */
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView, QListWidget {
    background-color: @SURFACE_1@; alternate-background-color: @ROW_ALT@; border: 1px solid @BORDER@;
    border-radius: 10px; gridline-color: @BORDER@; selection-background-color: @ACCENT_DIM@;
    selection-color: @TEXT@;
}
QTableView::item, QTreeView::item, QListView::item { padding: 6px 8px; border: none; }
QTableView::item:hover, QTreeView::item:hover, QListView::item:hover { background-color: @SURFACE_2@; }
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: @ACCENT_DIM@; color: @ACCENT@;
}
QHeaderView { background-color: @SURFACE_1@; border: none; }
QHeaderView::section {
    background-color: @SURFACE_2@; color: @MUTED@; padding: 9px 12px; border: none;
    border-bottom: 1px solid @BORDER_STRONG@; font-weight: 600; font-size: 12px;
}
QTableCornerButton::section { background-color: @SURFACE_2@; border: none; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { image: url("@ASSETS@/chevron-right.svg"); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { image: url("@ASSETS@/chevron-down.svg"); }
QListWidget#FoundList { background-color: @FIELD_BG@; border: 1px solid @BORDER@; border-radius: 10px; padding: 2px; }
QListWidget#FoundList::item { padding: 4px 8px; border-radius: 8px; color: @TEXT_DIM@; }
QListWidget#FoundList::item:hover { background-color: @SURFACE_2@; color: @TEXT@; }
QListWidget#FoundList::item:selected { background-color: @ACCENT_DIM@; color: @ACCENT@; }
QListWidget#TopicList { background-color: transparent; border: none; border-radius: 0; padding: 0; }
QListWidget#TopicList::item { padding: 8px 12px; margin: 1px 8px; border-radius: 8px; color: @TEXT_DIM@; }
QListWidget#TopicList::item:hover { background-color: @SURFACE_2@; color: @TEXT@; }
QListWidget#TopicList::item:selected { background-color: @ACCENT_DIM@; color: @ACCENT@; }

/* ---- tab ---------------------------------------------------------------------- */
QTabWidget::pane { border: 1px solid @BORDER@; border-radius: 10px; background-color: @BG_0@; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent; color: @MUTED@; padding: 10px 18px; border: none; border-bottom: 2px solid transparent;
    margin-right: 4px; font-weight: 500;
}
QTabBar::tab:hover { color: @TEXT@; border-bottom: 2px solid @BORDER_STRONG@; }
QTabBar::tab:selected { color: @ACCENT@; border-bottom: 2px solid @ACCENT@; font-weight: 600; }

/* ---- scrollbar ---------------------------------------------------------------- */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #3A4152; border-radius: 3px; min-height: 32px; min-width: 32px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #56607A; }
QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed { background: @ACCENT_ALT@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---- varie -------------------------------------------------------------------- */
QSplitter::handle { background-color: @BORDER@; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background-color: @ACCENT_ALT@; }
QStatusBar { background-color: @BG_1@; color: @MUTED@; border-top: 1px solid @BORDER@; font-size: 12px; }
QStatusBar::item { border: none; }
QMenu { background-color: @SURFACE_2@; border: 1px solid @BORDER_STRONG@; padding: 6px; border-radius: 10px; }
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background-color: @ACCENT_DIM@; color: @ACCENT@; }
QMenu::separator { height: 1px; background: @BORDER@; margin: 5px 8px; }
QProgressBar { background-color: @FIELD_BG@; border: 1px solid @BORDER@; border-radius: 6px; text-align: center; height: 10px; }
QProgressBar::chunk { background-color: @ACCENT@; border-radius: 5px; }
QMessageBox, QInputDialog { background-color: @SURFACE_1@; }
QMessageBox QLabel, QInputDialog QLabel { background: transparent; }
QFrame[frameShape="4"] { color: @BORDER@; background-color: @BORDER@; max-height: 1px; border: none; }
QAbstractScrollArea { background-color: transparent; }
QTextBrowser#HelpBrowser { background-color: @BG_1@; border: 1px solid @BORDER@; border-radius: 12px; padding: 4px; }

/* ---- diff viewer ---------------------------------------------------------------- */
QPlainTextEdit#CodeView { background-color: @FIELD_BG@; border: 1px solid @BORDER@; border-radius: 0; padding: 0; font-family: @FONT_MONO@; font-size: 12px; }
QWidget#DiffHeader { background-color: @SURFACE_2@; }
QLabel#DiffLabel { background-color: @SURFACE_2@; color: @MUTED@; font-weight: 600; padding: 7px 12px; font-size: 12px; }
